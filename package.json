{
  "name": "ffvi-reweb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-driven FFVI web migration and HD-2D reconstruction pipeline",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "npm test && node dist/src/cli.js validate",
    "pipeline": "npm run build && node dist/src/cli.js compile",
    "corpus:plan": "npm run build && node dist/src/cli.js corpus",
    "events:check": "npm run build && node scripts/check-events.mjs",
    "maps:check": "npm run build && node scripts/check-map-groups.mjs",
    "world:build": "npm run build && node scripts/build-world.mjs",
    "world:check": "npm run build && node scripts/check-world.mjs",
    "collision:check": "npm run build && node scripts/check-collision.mjs",
    "minimap:check": "npm run build && node scripts/check-minimap.mjs",
    "bgm:check": "npm run build && node scripts/check-bgm.mjs",
    "environment:check": "npm run build && node scripts/check-environment.mjs",
    "npc:check": "npm run build && node scripts/check-interactions.mjs npc",
    "objects:check": "npm run build && node scripts/check-interactions.mjs objects && node scripts/check-object-flow.mjs",
    "tiles:check": "npm run build && node scripts/check-tile-animation.mjs",
    "actors:check": "npm run build && node scripts/check-actor-animation.mjs",
    "doors:check": "npm run build && node scripts/check-open-trigger.mjs",
    "knowledge": "node dist/src/cli.js knowledge",
    "accept": "node dist/src/cli.js accept",
    "dev": "node scripts/serve.mjs",
    "game:build": "npm run build && node dist/src/cli.js field",
    "game:check": "npm run game:build && node scripts/check-field.mjs",
    "battle:build": "npm run build && node dist/src/cli.js battle",
    "battle:check": "npm run battle:build && node scripts/check-battle.mjs",
    "parameters:check": "npm run build && node scripts/check-parameters.mjs",
    "abilities:check": "npm run build && node scripts/check-abilities.mjs",
    "conditions:check": "npm run build && node scripts/check-conditions.mjs",
    "battle-conditions:check": "npm run battle:build && node scripts/check-battle-conditions.mjs",
    "battle-life:check": "npm run battle:build && node scripts/check-battle-life.mjs",
    "battle-ai:check": "npm run battle:build && node scripts/check-battle-ai.mjs",
    "battle-reactions:check": "npm run battle:build && node scripts/check-battle-reactions.mjs",
    "game-state:check": "npm run battle:build && node scripts/check-game-state.mjs",
    "magic:check": "npm run build && node scripts/check-magic.mjs",
    "physical:check": "npm run build && node scripts/check-physical.mjs",
    "battle-targets:check": "npm run battle:build && node scripts/check-battle-targets.mjs",
    "elements:check": "npm run battle:build && node scripts/check-elements.mjs",
    "playable:check": "npm run game:build && npm run battle:build && node scripts/check-playable.mjs"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "typescript": "5.9.3"
  }
}
