{
  "name": "ffvi-reweb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private FFVI Pixel Remaster web migration",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "export": "node tools/export/index.mjs",
    "dev": "node tools/play/serve-play.mjs",
    "test": "node --test src/play/*.test.mjs",
    "play:through": "node tools/play/playthrough.mjs",
    "play:ai-smoke": "node tools/play/smoke-monster-ai.mjs",
    "play:events-smoke": "node tools/play/smoke-battle-events.mjs",
    "play:commands-check": "node tools/play/check-play-commands.mjs",
    "play:ability-audit": "node tools/play/audit-play-abilities.mjs",
    "format": "prettier --write \"{src/play,apps/play,tools/export,tools/play}/**/*.{js,mjs,json,html,css}\" package.json",
    "format:check": "prettier --check \"{src/play,apps/play,tools/export,tools/play}/**/*.{js,mjs,json,html,css}\" package.json"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
