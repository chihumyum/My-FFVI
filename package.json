{
  "name": "ffvi-reweb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FFVI Pixel Remaster Web migration",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "export": "node tools/export/index.mjs",
    "dev": "vite --config vite.config.mjs",
    "test": "node --test src/play/*.test.mjs apps/play/*.test.mjs tools/export/*.test.mjs tools/play/*.test.mjs server/*.test.mjs cloudflare/*.test.mjs",
    "play:through": "node tools/play/playthrough.mjs",
    "play:story-screenshots": "node tools/play/capture-story-browser.mjs",
    "play:optional-inventory": "node tools/play/optional-inventory.mjs",
    "play:optional": "node tools/play/optional-run.mjs",
    "play:optional-npcs": "node tools/play/optional-npc-run.mjs",
    "play:optional-npc-summary": "node tools/play/optional-npc-summary.mjs",
    "play:ai-smoke": "node tools/play/smoke-monster-ai.mjs",
    "play:events-smoke": "node tools/play/smoke-battle-events.mjs",
    "play:commands-check": "node tools/play/check-play-commands.mjs",
    "play:battle-flow-check": "node tools/play/check-battle-flow-browser.mjs",
    "play:magic-target-check": "node tools/play/check-magic-targets-browser.mjs",
    "play:bug-report-check": "node tools/play/check-bug-report.mjs",
    "play:asset-audit": "node tools/play/audit-presentation.mjs",
    "play:asset-decode": "node tools/play/check-asset-decode.mjs",
    "play:extras-check": "node tools/play/check-extras-browser.mjs",
    "play:visual-check": "node tools/play/visual-regression.mjs",
    "play:static-check": "node tools/play/check-static-browser.mjs",
    "play:numeric-check": "node tools/play/numeric-audit.mjs",
    "play:boss-check": "node tools/play/boss-health-check.mjs",
    "play:ability-audit": "node tools/play/audit-play-abilities.mjs",
    "format": "prettier --write \"{src/play,apps/play,tools/export,tools/play,server,cloudflare}/**/*.{js,mjs,json,html,css}\" package.json vite.config.mjs wrangler.jsonc",
    "format:check": "prettier --check \"{src/play,apps/play,tools/export,tools/play,server,cloudflare}/**/*.{js,mjs,json,html,css}\" package.json vite.config.mjs wrangler.jsonc",
    "predev": "node tools/export/web.mjs",
    "bundle": "node tools/play/bundle.mjs",
    "host": "node server/cli.mjs",
    "host:backup": "node server/cli.mjs backup",
    "package:host": "node tools/play/package-host.mjs",
    "play:host-check": "node tools/play/check-host-browser.mjs",
    "play:loading-check": "node tools/play/check-loading-browser.mjs",
    "play:preload-check": "node tools/play/check-preload-browser.mjs",
    "cloudflare:prepare": "node tools/play/prepare-cloudflare.mjs",
    "cloudflare:dev": "wrangler d1 migrations apply ffvi-saves --local --env local --persist-to .wrangler/public-local && wrangler dev --env local --ip 127.0.0.1 --port 8788 --persist-to .wrangler/public-local",
    "cloudflare:deploy": "npm run cloudflare:prepare && npm run cloudflare:resources && npm run cloudflare:backup && wrangler d1 migrations apply ffvi-saves --remote && wrangler deploy --keep-vars",
    "cloudflare:backup": "node tools/play/backup-cloudflare.mjs",
    "cloudflare:deploy:first": "npm run cloudflare:prepare && npm run cloudflare:resources && wrangler d1 migrations apply ffvi-saves --remote && wrangler deploy --secrets-file private-data/cloudflare-secrets.json",
    "cloudflare:resources": "node tools/play/upload-resources.mjs",
    "dev:client": "vite --config vite.config.mjs",
    "bundle:client": "node tools/play/bundle-client.mjs"
  },
  "devDependencies": {
    "miniflare": "5.20261012.1-beta",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "vite": "8.3.4",
    "wrangler": "4.151.1"
  },
  "dependencies": {
    "pixi.js": "8.22.0"
  }
}
